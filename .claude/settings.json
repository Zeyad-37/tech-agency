{
  "board_backend": "markdown",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "gh *"
    ],
    "filesystem": {
      "allowWrite": [
        "../tech-agency-worktrees",
        "~/.gradle",
        "~/.m2",
        "~/.konan",
        "~/.npm",
        "~/.cache",
        "~/.cocoapods",
        "~/.android",
        "~/Library/Caches",
        "~/Library/Developer"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.kube",
        "~/.gnupg"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "dl.google.com",
        "plugins.gradle.org",
        "services.gradle.org",
        "*.gradle.org",
        "cdn.cocoapods.org",
        "*.cocoapods.org",
        "rubygems.org"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "Kotlin": {
      "source": {
        "source": "github",
        "repo": "Kotlin/kotlin-agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "kotlin-agent-skills@Kotlin": true
  },
  "agentModelRouting": {
    "atlas-orchestrator": "opus",
    "sage-solutions-architect": "opus",
    "shield-security-engineer": "opus",
    "diana-business-analyst": "sonnet",
    "morgan-product-owner": "sonnet",
    "pixel-ui-ux-designer": "sonnet",
    "nova-frontend-web": "sonnet",
    "swift-ios-engineer": "sonnet",
    "kai-android-engineer": "sonnet",
    "link-kmp-engineer": "sonnet",
    "flux-backend-node": "sonnet",
    "pyra-backend-python": "sonnet",
    "forge-backend-jvm": "sonnet",
    "neuron-ai-ml-engineer": "sonnet",
    "pipeline-data-engineer": "sonnet",
    "sentinel-devops-sre": "sonnet",
    "apex-qa-engineer": "sonnet",
    "scroll-technical-writer": "haiku",
    "echo-support-engineer": "haiku"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)"
    ],
    "deny": []
  }
}
