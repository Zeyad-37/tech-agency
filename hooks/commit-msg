#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Commit-Msg Hook — Validates commit message format
# Format: [STORY-ID] @AgentName: Short description
# Example: [US-042] @Kai: Add email validation to registration flow
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits
if echo "$COMMIT_MSG" | grep -qE '^Merge '; then
    exit 0
fi

# Skip initial/scaffold commits
if echo "$COMMIT_MSG" | grep -qE '^Initial '; then
    exit 0
fi

# Skip revert commits
if echo "$COMMIT_MSG" | grep -qE '^Revert '; then
    exit 0
fi

# Validate format: [STORY-ID] @Agent: description
# STORY-ID: one or more uppercase letters, a dash, one or more digits (e.g., US-042, T-001, BUG-123)
# Agent: @ followed by one or more word characters
# Description: at least 3 characters
if ! echo "$COMMIT_MSG" | head -1 | grep -qE '^\[[A-Z]+-[0-9]+\]\s+@[A-Za-z]+:\s+.{3,}'; then
    echo ""
    echo -e "${RED}❌ Commit message format is invalid.${NC}"
    echo ""
    echo -e "  ${YELLOW}Expected format:${NC} [STORY-ID] @AgentName: Short description"
    echo -e "  ${YELLOW}Example:${NC}         [US-042] @Kai: Add email validation to registration flow"
    echo ""
    echo -e "  Your message:  ${RED}$COMMIT_MSG${NC}"
    echo ""
    echo -e "  Rules:"
    echo -e "    - Story ID: uppercase letters + dash + number (e.g., US-042, T-001, BUG-123)"
    echo -e "    - Agent name: must start with @ (e.g., @Kai, @Swift, @Link)"
    echo -e "    - Description: at least 3 characters, describes what changed and why"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ Commit message format is valid.${NC}"
exit 0
