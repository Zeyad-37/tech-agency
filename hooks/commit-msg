#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Commit-Msg Hook — Validates commit message format
#
# Format: [TAG] @AgentName: Short description
#   TAG        — letters, optionally followed by -<number>.
#                Both forms are in active use: [US-042], [T-015], [BUG-017],
#                and bare [TECH] (what the release automation emits).
#   @AgentName — OPTIONAL. Present on agent-authored commits, absent on
#                tooling-authored ones.
#   description — at least 3 characters.
#
# Canonical regex (keep in sync with hooks/pre-push and
# .claude/rules/shared/git-hooks.md):
#   ^\[[A-Za-z]+(-[0-9]+)?\][[:space:]]+(@[A-Za-z]+:[[:space:]]+)?.{3,}
#
# Examples that pass:
#   [US-042] @Kai: Add email validation to registration flow
#   [T-015]  @Claude: Dynamic base-branch resolution
#   [TECH]   @Claude: Auto-bump VERSION to 0.1.12
#   [tech]   Tidy up the pre-push hook
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Only the SUBJECT (first line) is validated, and only the subject is tested
# against the skip rules below. Matching the skip patterns against the whole
# message lets a body line such as "Merge notes: see PR #12" bypass validation
# entirely.
SUBJECT=$(printf '%s\n' "$COMMIT_MSG" | head -1)

# Skip merge, initial/scaffold, and revert commits — git generates these
# subjects itself and they cannot carry a task tag.
case "$SUBJECT" in
    Merge\ *|Initial\ *|Revert\ *) exit 0 ;;
esac

COMMIT_SUBJECT_RE='^\[[A-Za-z]+(-[0-9]+)?\][[:space:]]+(@[A-Za-z]+:[[:space:]]+)?.{3,}'

if ! printf '%s\n' "$SUBJECT" | grep -qE "$COMMIT_SUBJECT_RE"; then
    echo ""
    echo -e "${RED}❌ Commit message format is invalid.${NC}"
    echo ""
    echo -e "  ${YELLOW}Expected format:${NC} [TAG] @AgentName: Short description"
    echo -e "  ${YELLOW}                 ${NC} (the @AgentName part is optional)"
    echo ""
    echo -e "  ${YELLOW}Examples:${NC} [US-042] @Kai: Add email validation to registration flow"
    echo -e "            [T-015] @Claude: Dynamic base-branch resolution"
    echo -e "            [TECH] @Claude: Auto-bump VERSION to 0.1.12"
    echo -e "            [tech] Tidy up the pre-push hook"
    echo ""
    echo -e "  Your subject line:  ${RED}$SUBJECT${NC}"
    echo ""
    echo -e "  Rules:"
    echo -e "    - Tag: letters in square brackets, optionally + dash + number"
    echo -e "           (US-042, T-001, BUG-123, TECH, tech)"
    echo -e "    - Agent name: optional; when present it is @Name followed by a colon"
    echo -e "    - Description: at least 3 characters, says what changed and why"
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ Commit message format is valid.${NC}"
exit 0
