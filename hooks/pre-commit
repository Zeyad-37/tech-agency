#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Pre-Commit Hook — Fast checks on every commit
# Install: ./hooks/install-hooks.sh (or manually symlink to .git/hooks/)
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0

echo "🔍 Running pre-commit checks..."

# ---------------------------------------------------------------------------
# 1. Commit message format: [STORY-ID] @Agent: description
#    (This runs via commit-msg hook too, but we validate staged content here)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 2. No secrets or credentials in staged files
# ---------------------------------------------------------------------------
echo -n "  Checking for secrets in staged files... "

SECRETS_PATTERN='(password|secret|api_key|apikey|access_token|auth_token|private_key|client_secret)\s*[:=]\s*["\x27][^"\x27]{8,}'
STAGED_FILES_Z=$(git diff --cached --name-only -z --diff-filter=ACM 2>/dev/null || true)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -n "$STAGED_FILES_Z" ]; then
    # Check for hardcoded secrets (case-insensitive, skip binary files with -I)
    SECRETS_FOUND=$(echo -n "$STAGED_FILES_Z" | xargs -0 grep -ilIE "$SECRETS_PATTERN" 2>/dev/null || true)

    # Filter out paths listed in .secret-scan-ignore (if the file exists)
    if [ -n "$SECRETS_FOUND" ] && [ -f ".secret-scan-ignore" ]; then
        FILTERED=""
        while IFS= read -r f; do
            if ! grep -qxF "$f" .secret-scan-ignore; then
                FILTERED="$FILTERED$f"$'\n'
            fi
        done <<< "$SECRETS_FOUND"
        SECRETS_FOUND=$(echo "$FILTERED" | sed '/^$/d')
    fi

    if [ -n "$SECRETS_FOUND" ]; then
        echo -e "${RED}FAILED${NC}"
        echo -e "  ${RED}Possible secrets detected in:${NC}"
        echo "$SECRETS_FOUND" | while read -r f; do echo "    - $f"; done
        echo -e "  ${YELLOW}If these are false positives, add them to .secret-scan-ignore${NC}"
        ERRORS=$((ERRORS + 1))
    else
        echo -e "${GREEN}OK${NC}"
    fi

    # Check for .env files being committed
    ENV_FILES=$(echo "$STAGED_FILES" | grep -E '\.env(\.[a-z]+)?$' | grep -v '\.env\.example$' | grep -v '\.env\.template$' || true)
    if [ -n "$ENV_FILES" ]; then
        echo -e "  ${RED}WARNING: .env files staged for commit:${NC}"
        echo "$ENV_FILES" | while read -r f; do echo "    - $f"; done
        echo -e "  ${YELLOW}Remove with: git reset HEAD <file>${NC}"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo -e "${GREEN}OK (no staged files)${NC}"
fi

# ---------------------------------------------------------------------------
# 3. No TODO/FIXME without a story ID
# ---------------------------------------------------------------------------
echo -n "  Checking for untracked TODOs/FIXMEs... "

if [ -n "$STAGED_FILES" ]; then
    # Get only added/modified lines in the diff
    UNTRACKED_TODOS=$(git diff --cached -U0 --diff-filter=ACM | grep -E '^\+.*\b(TODO|FIXME)\b' | grep -vE '\b(TODO|FIXME)\s*[\(\[]\s*[A-Z]+-[0-9]+' || true)
    if [ -n "$UNTRACKED_TODOS" ]; then
        echo -e "${YELLOW}WARNING${NC}"
        echo -e "  ${YELLOW}TODOs/FIXMEs found without story IDs:${NC}"
        echo "$UNTRACKED_TODOS" | head -5 | while read -r line; do echo "    $line"; done
        echo -e "  ${YELLOW}Use format: TODO(STORY-123) or FIXME[US-042]${NC}"
        # Warning only, not blocking
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${GREEN}OK${NC}"
fi

# ---------------------------------------------------------------------------
# 4. No force-unwraps (!!) in Kotlin files (KMP safety)
# ---------------------------------------------------------------------------
echo -n "  Checking for force-unwraps in Kotlin... "

KOTLIN_FILES=$(echo "$STAGED_FILES" | grep -E '\.kt$' || true)
if [ -n "$KOTLIN_FILES" ]; then
    FORCE_UNWRAPS=$(git diff --cached -U0 --diff-filter=ACM -- '*.kt' | grep -E '^\+.*!!' | grep -v '^\+\+\+' | grep -v '// safe:' || true)
    if [ -n "$FORCE_UNWRAPS" ]; then
        echo -e "${RED}FAILED${NC}"
        echo -e "  ${RED}Force-unwraps (!!) found in Kotlin code:${NC}"
        echo "$FORCE_UNWRAPS" | head -5 | while read -r line; do echo "    $line"; done
        echo -e "  ${YELLOW}Use safe calls (?.), elvis (?:), or require()/checkNotNull() instead.${NC}"
        echo -e "  ${YELLOW}If intentional, add '// safe: <reason>' on the same line.${NC}"
        ERRORS=$((ERRORS + 1))
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${GREEN}OK (no Kotlin files)${NC}"
fi

# ---------------------------------------------------------------------------
# 5. No force-unwraps (!) in Swift files
# ---------------------------------------------------------------------------
echo -n "  Checking for force-unwraps in Swift... "

SWIFT_FILES=$(echo "$STAGED_FILES" | grep -E '\.swift$' || true)
if [ -n "$SWIFT_FILES" ]; then
    # Match lines with ! force unwrap patterns, excluding common safe patterns
    SWIFT_FORCE=$(git diff --cached -U0 --diff-filter=ACM -- '*.swift' | grep -E '^\+' | grep -v '^\+\+\+' | grep -E '\w+!' | grep -v '// safe:' | grep -v '@IBOutlet' | grep -v '@IBAction' | grep -v 'import ' | grep -v '!=' | grep -v '!/=' || true)
    if [ -n "$SWIFT_FORCE" ]; then
        echo -e "${YELLOW}WARNING${NC}"
        echo -e "  ${YELLOW}Possible force-unwraps found in Swift code (review manually):${NC}"
        echo "$SWIFT_FORCE" | head -3 | while read -r line; do echo "    $line"; done
        # Warning only — Swift ! detection has too many false positives for a hard block
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${GREEN}OK (no Swift files)${NC}"
fi

# ---------------------------------------------------------------------------
# 6. Lint/format check (delegates to project-specific tooling)
# ---------------------------------------------------------------------------
echo -n "  Checking lint/format... "

LINTERS_RAN=false

# Kotlin (detekt)
if [ -n "$KOTLIN_FILES" ] && [ -f "gradlew" ]; then
    LINTERS_RAN=true
    if ! ./gradlew detekt --daemon -q 2>/dev/null; then
        echo -e "${RED}FAILED${NC}"
        echo -e "  ${RED}Detekt lint check failed. Run: ./gradlew detekt${NC}"
        ERRORS=$((ERRORS + 1))
    else
        echo -e "${GREEN}OK (Kotlin)${NC}"
    fi
fi

# TypeScript/JavaScript (eslint)
if echo "$STAGED_FILES" | grep -qE '\.(ts|tsx|js|jsx)$' && [ -f "package.json" ]; then
    TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' || true)
    if [ -n "$TS_FILES" ]; then
        LINTERS_RAN=true
        if command -v npx &>/dev/null && [ -f "node_modules/.bin/eslint" ]; then
            if ! echo "$TS_FILES" | xargs npx eslint --quiet 2>/dev/null; then
                echo -e "${RED}FAILED${NC}"
                echo -e "  ${RED}ESLint check failed. Run: npx eslint --fix${NC}"
                ERRORS=$((ERRORS + 1))
            else
                echo -e "${GREEN}OK (TypeScript/JavaScript)${NC}"
            fi
        else
            echo -e "${YELLOW}SKIPPED (eslint not installed)${NC}"
        fi
    fi
fi

# Python (ruff)
if echo "$STAGED_FILES" | grep -qE '\.py$'; then
    PY_FILES=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
    if [ -n "$PY_FILES" ]; then
        LINTERS_RAN=true
        if command -v ruff &>/dev/null; then
            if ! echo "$PY_FILES" | xargs ruff check --quiet 2>/dev/null; then
                echo -e "${RED}FAILED${NC}"
                echo -e "  ${RED}Ruff lint check failed. Run: ruff check --fix${NC}"
                ERRORS=$((ERRORS + 1))
            else
                echo -e "${GREEN}OK (Python)${NC}"
            fi
        else
            echo -e "${YELLOW}SKIPPED (ruff not installed)${NC}"
        fi
    fi
fi

# Swift (swiftlint)
if [ -n "$SWIFT_FILES" ]; then
    LINTERS_RAN=true
    if command -v swiftlint &>/dev/null; then
        if ! swiftlint lint --quiet 2>/dev/null; then
            echo -e "${RED}FAILED${NC}"
            echo -e "  ${RED}SwiftLint check failed. Run: swiftlint${NC}"
            ERRORS=$((ERRORS + 1))
        else
            echo -e "${GREEN}OK (Swift)${NC}"
        fi
    else
        echo -e "${YELLOW}SKIPPED (swiftlint not installed)${NC}"
    fi
fi

if ! $LINTERS_RAN; then
    echo -e "${YELLOW}SKIPPED (no matching linter found)${NC}"
fi

# ---------------------------------------------------------------------------
# 7. Large file check (>5MB)
# ---------------------------------------------------------------------------
echo -n "  Checking for large files... "

LARGE_FILES=""
if [ -n "$STAGED_FILES" ]; then
    while IFS= read -r file; do
        if [ -f "$file" ]; then
            SIZE=$(wc -c < "$file" 2>/dev/null || echo 0)
            if [ "$SIZE" -gt 5242880 ]; then
                LARGE_FILES="$LARGE_FILES\n    - $file ($(( SIZE / 1048576 ))MB)"
            fi
        fi
    done <<< "$STAGED_FILES"
fi

if [ -n "$LARGE_FILES" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "  ${RED}Large files (>5MB) staged:${NC}"
    echo -e "$LARGE_FILES"
    echo -e "  ${YELLOW}Consider using Git LFS or excluding these files.${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# ---------------------------------------------------------------------------
# 8. Auto-bump the version on commits to main
#    Runs only when all checks above passed AND the commit is on `main`.
#    Increments the patch segment of ./VERSION and stages it, so the bump
#    rides along in the same commit. To bump minor/major instead, edit VERSION
#    by hand and stage it — the idempotency guard below leaves it untouched.
#
#    NOTE: this is a client-side hook. It fires on *local* commits made while
#    on main. PR merges performed on the GitHub server (squash/merge button or
#    `gh pr merge`) do NOT run local hooks, so those won't bump — use a CI
#    workflow if you need server-side merges bumped too.
# ---------------------------------------------------------------------------
if [ $ERRORS -eq 0 ]; then
    BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
    if [ "$BRANCH" = "main" ]; then
        echo -n "  Bumping version (main)... "
        VERSION_FILE="VERSION"

        if git diff --cached --name-only | grep -qx "$VERSION_FILE"; then
            # VERSION is already staged — either an intentional manual bump, or
            # a prior commit attempt that a later hook aborted. Don't bump again
            # (prevents double-bumps across retried commits).
            echo -e "${YELLOW}already staged — leaving as-is${NC}"
        else
            CURRENT=$(tr -d ' \t\r\n' < "$VERSION_FILE" 2>/dev/null || echo "")
            if ! echo "$CURRENT" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
                CURRENT="0.0.0"
            fi
            MAJOR=${CURRENT%%.*}
            REST=${CURRENT#*.}
            MINOR=${REST%%.*}
            PATCH=${REST#*.}
            NEW="$MAJOR.$MINOR.$((PATCH + 1))"
            printf '%s\n' "$NEW" > "$VERSION_FILE"
            git add "$VERSION_FILE"
            echo -e "${GREEN}$CURRENT → $NEW${NC}"
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
echo ""
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}❌ Pre-commit check failed with $ERRORS error(s). Fix the issues above and try again.${NC}"
    exit 1
else
    echo -e "${GREEN}✅ All pre-commit checks passed.${NC}"
    exit 0
fi
