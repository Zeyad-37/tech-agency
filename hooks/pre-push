#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Pre-Push Hook — Heavier checks before code leaves the machine
# Install: ./hooks/install-hooks.sh (or manually symlink to .git/hooks/)
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

echo "🚀 Running pre-push checks..."

# Get the current branch name
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# ---------------------------------------------------------------------------
# 1. Branch naming convention
# ---------------------------------------------------------------------------
echo -n "  Checking branch naming... "

# Allowed patterns: story-id/description, hotfix/*, release/*, tech/*, deps/*, main, develop
if [[ "$BRANCH" == "main" || "$BRANCH" == "develop" ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^[A-Z]+-[0-9]+(\.[0-9]+)?/.+ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^epic/ ]]; then
    echo -e "${GREEN}OK ($BRANCH — integration branch)${NC}"
elif [[ "$BRANCH" =~ ^hotfix/ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^release/ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^tech/ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^deps/ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
else
    echo -e "${YELLOW}WARNING${NC}"
    echo -e "  ${YELLOW}Branch '$BRANCH' doesn't follow naming convention.${NC}"
    echo -e "  ${YELLOW}Expected: {STORY-ID}/{description}, epic/{EPIC-ID}-{slug}, tech/{description}, deps/{package}, hotfix/{version}/{description}${NC}"
    # Warning only, not blocking
fi

# ---------------------------------------------------------------------------
# 2. Prevent direct push to main
# ---------------------------------------------------------------------------
echo -n "  Checking push target... "

if [[ "$BRANCH" == "main" ]]; then
    echo -e "${RED}BLOCKED${NC}"
    echo -e "  ${RED}Direct push to main is not allowed. Use a pull request.${NC}"
    echo -e "  ${YELLOW}Create a PR: gh pr create --base main${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# ---------------------------------------------------------------------------
# 3. Commit message format validation (all commits being pushed)
# ---------------------------------------------------------------------------
echo -n "  Checking commit message format... "

# Only commits UNIQUE to this branch are validated. Commits already reachable
# from the remote main branch are excluded — after a rebase onto origin/main the
# naive $REMOTE_REF..HEAD range would include main's own history (squash-merge
# subjects like "[T-032] Title (#239)", bot commits like "CI: ... [skip ci]"),
# which can never match the required format and would force --no-verify.
REMOTE=${1:-origin}
# --verify --quiet: without it, rev-parse echoes the literal ref name to stdout
# even when the ref doesn't exist (e.g. first push of a new branch), poisoning
# EXCLUDE_REFS with a bogus ref and breaking the git log below.
REMOTE_REF=$(git rev-parse --verify --quiet "$REMOTE/$BRANCH" 2>/dev/null || echo "")
# Try the target remote's main first, then local main. (When REMOTE=origin the
# first lookup already covers origin/main; never fall back to a *different*
# remote's main — that could exclude the wrong history on multi-remote setups.)
MAIN_REF=$(git rev-parse --verify --quiet "$REMOTE/main" 2>/dev/null || git rev-parse --verify --quiet main 2>/dev/null || echo "")

EXCLUDE_REFS=""
[ -n "$REMOTE_REF" ] && EXCLUDE_REFS="$EXCLUDE_REFS $REMOTE_REF"
[ -n "$MAIN_REF" ] && EXCLUDE_REFS="$EXCLUDE_REFS $MAIN_REF"

if [ -n "$EXCLUDE_REFS" ]; then
    # EXCLUDE_REFS is intentionally unquoted: space-separated commit hashes
    # shellcheck disable=SC2086
    COMMITS=$(git log --oneline HEAD --not $EXCLUDE_REFS 2>/dev/null) || {
        echo -e "  ${YELLOW}WARNING: could not list commits for format check — skipping${NC}"
        COMMITS=""
    }
else
    COMMITS=""
fi

BAD_COMMITS=""
if [ -n "$COMMITS" ]; then
    while IFS= read -r commit; do
        HASH=$(echo "$commit" | cut -d' ' -f1)
        MSG=$(git log --format=%s -1 "$HASH" 2>/dev/null || true)
        # Skip merge commits and initial commits
        if [[ "$MSG" == Merge* ]] || [[ "$MSG" == "Initial"* ]]; then
            continue
        fi
        # Check format: [STORY-ID] @Agent: description
        if ! echo "$MSG" | grep -qE '^\[[A-Z]+(-[0-9]+(\.[0-9]+)?)?\] @[A-Za-z]+: '; then
            BAD_COMMITS="$BAD_COMMITS\n    - $HASH: $MSG"
        fi
    done <<< "$COMMITS"
fi

if [ -n "$BAD_COMMITS" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "  ${RED}Commits with incorrect format:${NC}"
    echo -e "$BAD_COMMITS"
    echo -e "  ${YELLOW}Expected format: [STORY-ID] @Agent: description${NC}"
    echo -e "  ${YELLOW}Example: [US-042] @Kai: Add email validation to registration flow${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# ---------------------------------------------------------------------------
# 3b. Rules mirror integrity (consumer repos only)
#
# .claude/rules/ is a generated mirror of the tech-agency plugin's rules — see
# .claude/rules/rules-mirror.md. A hand-edited mirror file is drift that would
# otherwise never be noticed, so it blocks the push. Skipped in tech-agency
# itself, which owns the rules and has no manifest.
# ---------------------------------------------------------------------------
if [ -f ".claude/rules/.synced-from" ]; then
    # mirror.sh ships inside the plugin, so a consumer normally has no local
    # copy. Resolve it the same way mirror.sh resolves its own source, or the
    # check silently never runs — which is the failure mode this epic exists
    # to remove.
    MIRROR_SH=""
    for c in ".claude/skills/sync-rule/mirror.sh" \
             "${CLAUDE_PLUGIN_ROOT:-}/skills/sync-rule/mirror.sh"; do
        [ -n "$c" ] && [ -f "$c" ] && MIRROR_SH="$c" && break
    done
    if [ -z "$MIRROR_SH" ]; then
        MIRROR_SH=$(find "$HOME/.claude/plugins/cache" -maxdepth 6 \
                      -path '*/tech-agency/*/skills/sync-rule/mirror.sh' 2>/dev/null \
                    | sort -V | tail -1)
    fi

    echo -n "  Checking rules mirror... "
    if [ -z "$MIRROR_SH" ]; then
        # A manifest exists but the checker cannot be found. Say so loudly:
        # a mirror nobody verifies is exactly how the drift started.
        echo -e "${YELLOW}SKIPPED${NC}"
        echo -e "  ${YELLOW}.claude/rules/.synced-from exists but mirror.sh was not found.${NC}"
        echo -e "  ${YELLOW}Install the plugin, or set CLAUDE_PLUGIN_ROOT. The mirror is UNVERIFIED.${NC}"
    elif MIRROR_OUT=$(bash "$MIRROR_SH" check 2>&1); then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}DRIFT${NC}"
        echo "$MIRROR_OUT" | sed 's/^/  /'
        ERRORS=$((ERRORS + 1))
    fi
fi

# ---------------------------------------------------------------------------
# 4. Run tests for affected modules
# ---------------------------------------------------------------------------
echo -n "  Running tests... "

# Detect which files changed
if [ -n "$REMOTE_REF" ]; then
    CHANGED_FILES=$(git diff --name-only "$REMOTE_REF..HEAD" 2>/dev/null || true)
else
    CHANGED_FILES=$(git diff --name-only "$(git merge-base HEAD main 2>/dev/null || echo HEAD~1)..HEAD" 2>/dev/null || true)
fi

TEST_FAILED=false

TESTS_RAN=false

# Kotlin/JVM/Android (Gradle)
if echo "$CHANGED_FILES" | grep -qE '\.(kt|kts|java)$' && [ -f "gradlew" ]; then
    TESTS_RAN=true
    echo ""
    echo -e "  ${YELLOW}Running Gradle tests...${NC}"
    if ! ./gradlew test --daemon -q 2>&1 | tail -5; then
        TEST_FAILED=true
    fi
fi

# TypeScript/JavaScript (Node)
if echo "$CHANGED_FILES" | grep -qE '\.(ts|tsx|js|jsx)$' && [ -f "package.json" ]; then
    TESTS_RAN=true
    echo ""
    echo -e "  ${YELLOW}Running npm tests...${NC}"
    if command -v npm &>/dev/null; then
        if ! npm test --silent 2>&1 | tail -5; then
            TEST_FAILED=true
        fi
    fi
fi

# Python
if echo "$CHANGED_FILES" | grep -qE '\.py$'; then
    TESTS_RAN=true
    echo ""
    echo -e "  ${YELLOW}Running pytest...${NC}"
    if command -v pytest &>/dev/null; then
        if ! pytest -q 2>&1 | tail -5; then
            TEST_FAILED=true
        fi
    fi
fi

# Swift/iOS
if echo "$CHANGED_FILES" | grep -qE '\.swift$' && { [ -f "Package.swift" ] || compgen -G "*.xcodeproj" > /dev/null 2>&1; }; then
    TESTS_RAN=true
    echo ""
    echo -e "  ${YELLOW}Running Swift tests...${NC}"
    if command -v swift &>/dev/null; then
        if ! swift test --quiet 2>&1 | tail -5; then
            TEST_FAILED=true
        fi
    fi
fi

if ! $TESTS_RAN; then
    echo -e "${YELLOW}SKIPPED (no matching test runner found)${NC}"
fi

if $TEST_FAILED; then
    echo -e "  ${RED}Tests FAILED. Fix failing tests before pushing.${NC}"
    ERRORS=$((ERRORS + 1))
elif echo "$CHANGED_FILES" | grep -qE '\.(kt|kts|java|ts|tsx|js|jsx|py|swift)$'; then
    echo -e "  ${GREEN}Tests passed.${NC}"
fi

# ---------------------------------------------------------------------------
# 5. Build verification
# ---------------------------------------------------------------------------
echo -n "  Verifying build... "

BUILD_FAILED=false

if echo "$CHANGED_FILES" | grep -qE '\.(kt|kts|java)$' && [ -f "gradlew" ]; then
    if ! ./gradlew assemble --daemon -q 2>/dev/null; then
        BUILD_FAILED=true
    fi
elif echo "$CHANGED_FILES" | grep -qE '\.(ts|tsx|js|jsx)$' && [ -f "package.json" ]; then
    if command -v npm &>/dev/null && grep -q '"build"' package.json 2>/dev/null; then
        if ! npm run build --silent 2>/dev/null; then
            BUILD_FAILED=true
        fi
    fi
elif echo "$CHANGED_FILES" | grep -qE '\.py$' && [ -f "pyproject.toml" ]; then
    # Python type-check as build verification
    if command -v mypy &>/dev/null; then
        if ! mypy src/ --quiet 2>/dev/null; then
            BUILD_FAILED=true
        fi
    fi
fi

if $BUILD_FAILED; then
    echo -e "${RED}FAILED${NC}"
    echo -e "  ${RED}Build failed. Fix build errors before pushing.${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
echo ""
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}❌ Pre-push check failed with $ERRORS error(s). Fix the issues above and try again.${NC}"
    echo -e "${YELLOW}To bypass (emergency only): git push --no-verify${NC}"
    exit 1
else
    echo -e "${GREEN}✅ All pre-push checks passed. Pushing...${NC}"
    exit 0
fi
