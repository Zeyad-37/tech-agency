#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Pre-Push Hook — Heavier checks before code leaves the machine
# Install: ./hooks/install-hooks.sh (or manually symlink to .git/hooks/)
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

echo "🚀 Running pre-push checks..."

# Get the current branch name
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# ---------------------------------------------------------------------------
# 1. Branch naming convention
# ---------------------------------------------------------------------------
echo -n "  Checking branch naming... "

# Allowed patterns: story-id/description, hotfix/*, release/*, tech/*, deps/*, main, develop
if [[ "$BRANCH" == "main" || "$BRANCH" == "develop" ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^[A-Z]+-[0-9]+/.+ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^hotfix/ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^release/ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^tech/ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
elif [[ "$BRANCH" =~ ^deps/ ]]; then
    echo -e "${GREEN}OK ($BRANCH)${NC}"
else
    echo -e "${YELLOW}WARNING${NC}"
    echo -e "  ${YELLOW}Branch '$BRANCH' doesn't follow naming convention.${NC}"
    echo -e "  ${YELLOW}Expected: {STORY-ID}/{description}, tech/{description}, deps/{package}, hotfix/{version}/{description}${NC}"
    # Warning only, not blocking
fi

# ---------------------------------------------------------------------------
# 2. Prevent direct push to main
# ---------------------------------------------------------------------------
echo -n "  Checking push target... "

if [[ "$BRANCH" == "main" ]]; then
    echo -e "${RED}BLOCKED${NC}"
    echo -e "  ${RED}Direct push to main is not allowed. Use a pull request.${NC}"
    echo -e "  ${YELLOW}Create a PR: gh pr create --base main${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# ---------------------------------------------------------------------------
# 3. Commit message format validation (all commits being pushed)
# ---------------------------------------------------------------------------
echo -n "  Checking commit message format... "

# Get commits that will be pushed (local commits not yet on remote)
REMOTE=${1:-origin}
REMOTE_REF=$(git rev-parse "$REMOTE/$BRANCH" 2>/dev/null || echo "")

if [ -n "$REMOTE_REF" ]; then
    COMMITS=$(git log --oneline "$REMOTE_REF..HEAD" 2>/dev/null || true)
else
    # New branch — check all commits since branching from main
    MAIN_REF=$(git rev-parse origin/main 2>/dev/null || git rev-parse main 2>/dev/null || echo "")
    if [ -n "$MAIN_REF" ]; then
        COMMITS=$(git log --oneline "$MAIN_REF..HEAD" 2>/dev/null || true)
    else
        COMMITS=""
    fi
fi

BAD_COMMITS=""
if [ -n "$COMMITS" ]; then
    while IFS= read -r commit; do
        HASH=$(echo "$commit" | cut -d' ' -f1)
        MSG=$(git log --format=%s -1 "$HASH" 2>/dev/null || true)
        # Skip merge commits and initial commits
        if [[ "$MSG" == Merge* ]] || [[ "$MSG" == "Initial"* ]]; then
            continue
        fi
        # Check format: [STORY-ID] @Agent: description
        if ! echo "$MSG" | grep -qE '^\[[A-Z]+-[0-9]+\]\s+@[A-Za-z]+:'; then
            BAD_COMMITS="$BAD_COMMITS\n    - $HASH: $MSG"
        fi
    done <<< "$COMMITS"
fi

if [ -n "$BAD_COMMITS" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "  ${RED}Commits with incorrect format:${NC}"
    echo -e "$BAD_COMMITS"
    echo -e "  ${YELLOW}Expected format: [STORY-ID] @Agent: description${NC}"
    echo -e "  ${YELLOW}Example: [US-042] @Kai: Add email validation to registration flow${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# ---------------------------------------------------------------------------
# 4. Run tests for affected modules
# ---------------------------------------------------------------------------
echo -n "  Running tests... "

# Detect which files changed
if [ -n "$REMOTE_REF" ]; then
    CHANGED_FILES=$(git diff --name-only "$REMOTE_REF..HEAD" 2>/dev/null || true)
else
    CHANGED_FILES=$(git diff --name-only "$(git merge-base HEAD main 2>/dev/null || echo HEAD~1)..HEAD" 2>/dev/null || true)
fi

TEST_FAILED=false

TESTS_RAN=false

# Kotlin/JVM/Android (Gradle)
if echo "$CHANGED_FILES" | grep -qE '\.(kt|kts|java)$' && [ -f "gradlew" ]; then
    TESTS_RAN=true
    echo ""
    echo -e "  ${YELLOW}Running Gradle tests...${NC}"
    if ! ./gradlew test --daemon -q 2>&1 | tail -5; then
        TEST_FAILED=true
    fi
fi

# TypeScript/JavaScript (Node)
if echo "$CHANGED_FILES" | grep -qE '\.(ts|tsx|js|jsx)$' && [ -f "package.json" ]; then
    TESTS_RAN=true
    echo ""
    echo -e "  ${YELLOW}Running npm tests...${NC}"
    if command -v npm &>/dev/null; then
        if ! npm test --silent 2>&1 | tail -5; then
            TEST_FAILED=true
        fi
    fi
fi

# Python
if echo "$CHANGED_FILES" | grep -qE '\.py$'; then
    TESTS_RAN=true
    echo ""
    echo -e "  ${YELLOW}Running pytest...${NC}"
    if command -v pytest &>/dev/null; then
        if ! pytest -q 2>&1 | tail -5; then
            TEST_FAILED=true
        fi
    fi
fi

# Swift/iOS
if echo "$CHANGED_FILES" | grep -qE '\.swift$' && { [ -f "Package.swift" ] || compgen -G "*.xcodeproj" > /dev/null 2>&1; }; then
    TESTS_RAN=true
    echo ""
    echo -e "  ${YELLOW}Running Swift tests...${NC}"
    if command -v swift &>/dev/null; then
        if ! swift test --quiet 2>&1 | tail -5; then
            TEST_FAILED=true
        fi
    fi
fi

if ! $TESTS_RAN; then
    echo -e "${YELLOW}SKIPPED (no matching test runner found)${NC}"
fi

if $TEST_FAILED; then
    echo -e "  ${RED}Tests FAILED. Fix failing tests before pushing.${NC}"
    ERRORS=$((ERRORS + 1))
elif echo "$CHANGED_FILES" | grep -qE '\.(kt|kts|java|ts|tsx|js|jsx|py|swift)$'; then
    echo -e "  ${GREEN}Tests passed.${NC}"
fi

# ---------------------------------------------------------------------------
# 5. Build verification
# ---------------------------------------------------------------------------
echo -n "  Verifying build... "

BUILD_FAILED=false

if echo "$CHANGED_FILES" | grep -qE '\.(kt|kts|java)$' && [ -f "gradlew" ]; then
    if ! ./gradlew assemble --daemon -q 2>/dev/null; then
        BUILD_FAILED=true
    fi
elif echo "$CHANGED_FILES" | grep -qE '\.(ts|tsx|js|jsx)$' && [ -f "package.json" ]; then
    if command -v npm &>/dev/null && grep -q '"build"' package.json 2>/dev/null; then
        if ! npm run build --silent 2>/dev/null; then
            BUILD_FAILED=true
        fi
    fi
elif echo "$CHANGED_FILES" | grep -qE '\.py$' && [ -f "pyproject.toml" ]; then
    # Python type-check as build verification
    if command -v mypy &>/dev/null; then
        if ! mypy src/ --quiet 2>/dev/null; then
            BUILD_FAILED=true
        fi
    fi
fi

if $BUILD_FAILED; then
    echo -e "${RED}FAILED${NC}"
    echo -e "  ${RED}Build failed. Fix build errors before pushing.${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
echo ""
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}❌ Pre-push check failed with $ERRORS error(s). Fix the issues above and try again.${NC}"
    echo -e "${YELLOW}To bypass (emergency only): git push --no-verify${NC}"
    exit 1
else
    echo -e "${GREEN}✅ All pre-push checks passed. Pushing...${NC}"
    exit 0
fi
